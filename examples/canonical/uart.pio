    inc uart_rx_check
    mov a,uart_rx_ctlr
    xor uart_rx_check,a
rx_check_3:
    mov a,timer0.count
    add a,uart_rx_cnt
    jmp nc,rx_check_3
    mov a,uart_rx_var
    rorc uart_rx_var
    xor uart_rx_var,a
    skip clear,uart_rx_ctlr[4]
    call delay_5nop
    clr timer0.count
    skip clear,uart_rx_var[0]
    bset uart_rx_sr[2]
    clr uart_rx_var
    nop
rx_stop_0:
    mov a,timer0.count
    add a,uart_rx_cnt
    jmp nc,rx_stop_0
    nop
    mov c,pins.in0
    skip clear,status.carry
    inc uart_rx_var
    nop
    clr timer0.count
    skip clear,uart_rx_check[0]
    bset uart_rx_sr[0]
    nop
rx_stop:
    nop
rx_stop_1:
    mov a,timer0.count
    add a,uart_rx_cnt
    jmp nc,rx_stop_1
    mov c,pins.in0
    skip clear,status.carry
    inc uart_rx_var
    skip clear,uart_rx_ctlr[6]
    call delay_5nop
    clr timer0.count
    skip clear,uart_rx_ctlr[7]
    jmp rx_stop_3
    nop
    nop
rx_stop_2:
    mov a,timer0.count
    add a,uart_rx_cnt
    jmp nc,rx_stop_2
rx_stop_3:
    mov c,pins.in0
    skip clear,status.carry
    inc uart_rx_var
    skip set,uart_rx_var[1]
    bset uart_rx_sr[1]
    mov a,uart_rx_var
    rorc uart_rx_var
    xor uart_rx_var,a
    skip clear,uart_rx_var[0]
    bset uart_rx_sr[2]
    mov a,xchg
    mov uart_rx_data,a
    bset sys.irq_request
    jmp rx_wait


mcu_start:
    nop
    nop
    bset pins.out1
    bset pins.out0
    mov pins.dir,#0b00000010
    wait host_to_core_pending
    mov a,#0x08
    mov uart_tx_i,a
    clr uart_rx_sr
    mov ptr1,#sfr_data_reg8
    skip clear,uart_tx_rx_flag[0]
    jmp uart_tx
    jmp uart_rx
    jmp mcu_start

    .end

